# Leave unset to run the dashboard against bundled demo data (shaped exactly
# like the research-agent benchmark). Set these to point it at a real API.
# Not NEXT_PUBLIC_-prefixed: read server-side at request time (see lib/api.ts),
# so these are ordinary runtime env vars -- no rebuild needed to change them.
COMPUTELAYER_API_URL=http://localhost:8000/v1
COMPUTELAYER_API_KEY=cl_test_local_development_key
COMPUTELAYER_PROJECT=research-agent
