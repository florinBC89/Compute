# Supabase project (Settings -> API). The publishable/anon key is safe for
# client-side use -- it's what @supabase/ssr's browser client uses. Real
# access control lives in Postgres RLS / the API's JWT verification, not in
# keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# This app's own public URL, used to build the magic-link callback
# (Settings -> Auth -> URL Configuration in Supabase must allow it too).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# The ComputeLayer API this workspace talks to (same API apps/dashboard
# uses). Not NEXT_PUBLIC_-prefixed: called server-side only, forwarding the
# signed-in user's Supabase access token as the bearer token.
COMPUTELAYER_API_URL=http://localhost:8000/v1
