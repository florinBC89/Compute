# ComputeLayer environment (spec §55)

# --- SDK -------------------------------------------------------------------
COMPUTELAYER_API_URL=http://localhost:8000/v1
COMPUTELAYER_API_KEY=cl_test_local_development_key
COMPUTELAYER_PROJECT=research-agent
# Populate with your deployment's git SHA in production (§22).
COMPUTELAYER_CODE_VERSION=

# --- API -------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://computelayer:computelayer@localhost:5432/computelayer
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_URL=file:///var/lib/computelayer/artifacts
LARGE_OUTPUT_THRESHOLD_BYTES=1048576
LOCK_TTL_SECONDS=60
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Created on first start for local development.
BOOTSTRAP_WORKSPACE=local
BOOTSTRAP_PROJECT=research-agent
BOOTSTRAP_API_KEY=cl_test_local_development_key

# --- LLM providers ---------------------------------------------------------
OPENROUTER_API_KEY=
